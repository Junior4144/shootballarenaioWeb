{
  "name": "@shootball/admin-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --alias:@shootball/admin-contracts=../../packages/admin-contracts/src/index.ts --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@posthog/cli": "^0.18.9",
    "@shootball/admin-contracts": "0.0.0",
    "@supabase/supabase-js": "2.117.2",
    "google-auth-library": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
