{
  "name": "@shootball/admin-api", "version": "0.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts", "start": "node dist/index.js",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --alias:@shootball/admin-contracts=../../packages/admin-contracts/src/index.ts --outfile=dist/index.js",
    "typecheck": "tsc --noEmit", "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": { "@shootball/admin-contracts": "0.0.0", "google-auth-library": "^10.0.0", "@supabase/supabase-js": "2.117.2" },
  "devDependencies": { "@types/node": "^24.13.6", "tsx": "^4.23.15", "typescript": "^5.9.3", "esbuild": "^0.28.2" }
}
