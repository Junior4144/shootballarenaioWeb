{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "same-origin",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "same-origin",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/admin/?",
      "dest": "https://shootball-control-test-730016272076.us-central1.run.app/admin/index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "https://shootball-control-test-730016272076.us-central1.run.app/admin/$1"
    },
    {
      "src": "/(health|healthz)",
      "dest": "https://shootball-control-test-730016272076.us-central1.run.app/$1"
    },
    {
      "src": "/(?:|index.html|release.json)",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404 }
  ]
}
